{
  "name": "muxcloud-mobile",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "private": true,
  "description": "Mux Cloud mobile app: your mux machines and conversations from a phone or tablet.",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && npm run lint:shared",
    "lint:shared": "cd .. && node MuxCloud.Mobile/node_modules/eslint/bin/eslint.js --max-warnings 0 --config MuxCloud.Mobile/eslint.dashboard-shared.config.js MuxCloud.Dashboard/src",
    "test": "jest",
    "test:ci": "jest --ci",
    "parity:check": "jest src/__tests__/parity.test.ts",
    "parity:update": "node scripts/parity.js --write",
    "audit:check": "node scripts/check-audit.js",
    "i18n:check": "jest src/__tests__/i18n.test.ts",
    "export:check": "expo export --platform ios --platform android --output-dir dist",
    "verify": "npm run typecheck && npm run lint && npm run i18n:check && npm run parity:check && npm run audit:check && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-getcanonicallocales": "^3.4.0",
    "@formatjs/intl-listformat": "^9.1.0",
    "@formatjs/intl-locale": "^5.5.0",
    "@formatjs/intl-pluralrules": "^7.1.0",
    "@formatjs/intl-relativetimeformat": "^13.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "i18next": "^27.1.5",
    "marked": "^18.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  }
}
