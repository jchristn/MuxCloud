{
  "name": "muxcloud-dashboard",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "description": "Mux Cloud web dashboard: accounts, machines, and each machine's relayed mux dashboard.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "npm run i18n:check && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "i18next": "27.1.5",
    "i18next-browser-languagedetector": "8.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
