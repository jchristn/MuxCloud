<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MuxCloud.Protocol</PackageId>
    <Title>MuxCloud.Protocol</Title>
    <Description>Wire contracts for the Mux Cloud tunnel: the persistent WebSocket a mux machine keeps open to Mux Cloud, its envelope and payload models, handshake proofs, close codes, and reconnect policy.</Description>
    <PackageTags>mux;muxcloud;tunnel;websocket;relay</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
