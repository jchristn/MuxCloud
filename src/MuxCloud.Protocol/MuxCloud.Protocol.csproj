<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MuxCloud.Protocol</PackageId>
    <Title>MuxCloud.Protocol</Title>
    <Description>Wire contracts for the Mux Cloud tunnel: the persistent WebSocket a mux machine keeps open to Mux Cloud, its envelope and payload models, handshake proofs, close codes, and reconnect policy.</Description>
    <PackageTags>mux;muxcloud;mux-cloud;ai;agent;coding-agent;llm;tunnel;websocket;relay;remote-access;protocol;hmac;aot</PackageTags>
    <PackageReleaseNotes>2.0.0: First stable release, for mux 2.0.0. Tunnel protocol version 1: envelope and typed payloads (handshake, heartbeat, streamed HTTP relay, cancel, WebSocket channels, machine status), HMAC-SHA256 handshake and sign-out proofs, close and error codes, capabilities, header filtering, reconnect backoff, and source-generated JSON for Native AOT. See WEBSOCKETS_API.md.</PackageReleaseNotes>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
